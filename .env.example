# 正式活动使用全新的持久化目录，避免带入开发演示数据。
DATA_DIR=./data-live
SEED_DEMO=false
ACTIVITY_DATE=2026-11-01
ACTIVITY_OPEN=08:00
ACTIVITY_CLOSE=18:00
# 验证期间关闭定时开放与自动结榜；恢复正式赛程设为 true。
ACTIVITY_TIME_LIMITS=false
PORT=3001
# 服务器经 nginx 代理时可仅监听 127.0.0.1。
HOST=0.0.0.0
# 管理口令至少 8 个字符；留空则生成于 DATA_DIR/admin-key.txt。
ADMIN_KEY=
# 仅服务端使用，请勿配置 VITE_ 前缀。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# HTTPS 反向代理就绪后设 true，本地 HTTP 保持 false。
COOKIE_SECURE=false
# 子路径部署时，构建使用 BASE_PATH，Cookie 路径使用 COOKIE_PATH。
BASE_PATH=/
COOKIE_PATH=/
